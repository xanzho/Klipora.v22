
/* =========================================================
   KLIPORA — COMPLETE STANDALONE STYLESHEET
   Crimson • Midnight • Warm Gold
   Works with the existing index.html and app.js
   ========================================================= */

:root {
  color-scheme: dark;
  --bg: #090a12;
  --panel: #17131f;
  --panel-light: #211925;
  --line: rgba(255, 255, 255, 0.11);
  --text: #fff8f5;
  --muted: #b7aab7;
  --red: #ff405d;
  --red-light: #ff788a;
  --gold: #f2bc69;
  --radius: 22px;
  --shadow: 0 25px 80px rgba(0, 0, 0, 0.38);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(ellipse at 5% 5%, rgba(180, 25, 60, 0.24), transparent 35%),
    radial-gradient(ellipse at 95% 15%, rgba(222, 157, 64, 0.13), transparent 30%),
    radial-gradient(ellipse at 50% 75%, rgba(87, 37, 101, 0.17), transparent 40%),
    var(--bg);
  color: var(--text);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

body::before {
  content: "";
  position: fixed;
  z-index: -1;
  inset: -30%;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 25% 30%, rgba(255, 40, 85, 0.10), transparent 30%),
    radial-gradient(ellipse at 70% 60%, rgba(242, 188, 105, 0.08), transparent 30%);
  filter: blur(45px);
  animation: atmosphere 18s ease-in-out infinite alternate;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
a:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 4px;
}

a {
  color: inherit;
  text-decoration: none;
}

.hidden {
  display: none !important;
}

/* Header */

.topbar {
  width: min(1120px, calc(100% - 40px));
  min-height: 78px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 21px;
  font-weight: 850;
  letter-spacing: -0.8px;
}

.brand-mark {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 64, 93, 0.55);
  border-radius: 13px;
  background: linear-gradient(145deg, rgba(255, 64, 93, 0.24), rgba(242, 188, 105, 0.10));
  color: #ff647c;
  box-shadow: 0 0 28px rgba(255, 64, 93, 0.14);
  transition: transform 250ms ease, box-shadow 250ms ease;
}

.brand:hover .brand-mark {
  transform: rotate(-8deg) scale(1.06);
  box-shadow: 0 0 32px rgba(255, 64, 93, 0.30);
}

.local-tag {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 7px 12px;
  border: 1px solid rgba(242, 188, 105, 0.23);
  border-radius: 999px;
  background: rgba(242, 188, 105, 0.055);
  color: #e8c895;
  font-size: 12px;
  font-weight: 650;
  white-space: nowrap;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #f2bc69;
  box-shadow: 0 0 12px rgba(242, 188, 105, 0.75);
  animation: pulse 2s infinite;
}

/* Main layout */

.shell {
  width: min(850px, calc(100% - 40px));
  margin: 0 auto;
  padding: 65px 0 50px;
}

.hero {
  margin: 0 auto 34px;
  text-align: center;
  animation: rise-in 700ms both;
}

.eyebrow {
  width: fit-content;
  max-width: 100%;
  margin: 0 auto 19px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 6px 12px;
  border: 1px solid rgba(255, 64, 93, 0.28);
  border-radius: 999px;
  background: linear-gradient(100deg, rgba(255, 64, 93, 0.10), rgba(242, 188, 105, 0.045));
  color: #ff9aa7;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.spark {
  color: var(--gold);
  font-size: 15px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(38px, 6.5vw, 65px);
  font-weight: 850;
  letter-spacing: -3.5px;
  line-height: 1.08;
}

.hero h1 span {
  display: inline-block;
  padding-bottom: 5px;
  background: linear-gradient(100deg, #ff405d 5%, #ff8c80 36%, #f2bc69 67%, #e7a4bd 92%);
  background-size: 200% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradient-flow 8s linear infinite;
}

.subtitle {
  max-width: 510px;
  margin: 20px auto 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

/* Main downloader panel */

.panel {
  position: relative;
  overflow: hidden;
  padding: 9px;
  border: 1px solid rgba(168, 101, 119, 0.30);
  border-radius: var(--radius);
  background: linear-gradient(145deg, rgba(35, 24, 38, 0.96), rgba(17, 17, 29, 0.97) 65%);
  box-shadow: var(--shadow), 0 0 60px rgba(255, 64, 93, 0.035);
  animation: rise-in 800ms 100ms both;
  transition: border-color 250ms ease, box-shadow 250ms ease;
}

.panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 10%;
  right: 10%;
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, #ff405d, #f2bc69, transparent);
  opacity: 0.8;
}

.panel:hover {
  border-color: rgba(255, 112, 133, 0.42);
  box-shadow: var(--shadow), 0 0 55px rgba(255, 64, 93, 0.06);
}

/* Tabs */

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  padding: 7px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.tab {
  min-height: 47px;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 13px;
  background: transparent;
  color: #b7aab9;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 220ms ease, color 220ms ease, border-color 220ms ease, transform 220ms ease;
}

.tab span {
  margin-right: 7px;
  color: #c0aebf;
}

.tab:hover {
  background: rgba(255, 255, 255, 0.035);
  color: #fff;
}

.tab:active {
  transform: scale(0.985);
}

.tab.active {
  border-color: rgba(255, 64, 93, 0.25);
  background: linear-gradient(110deg, rgba(255, 64, 93, 0.15), rgba(242, 188, 105, 0.055));
  color: #ff8797;
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
}

.tab.active span {
  color: #ff647c;
}

/* Input panes */

.pane {
  padding: 25px 22px 23px;
}

.pane label {
  display: block;
  margin-bottom: 9px;
  color: #f7eaf0;
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 0.2px;
}

.url-row {
  display: flex;
  gap: 10px;
  align-items: stretch;
}

.url-row input,
textarea,
select {
  width: 100%;
  min-width: 0;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  background: rgba(6, 7, 15, 0.65);
  color: var(--text);
  transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
}

.url-row input {
  min-height: 51px;
  padding: 0 15px;
}

textarea {
  display: block;
  min-height: 86px;
  padding: 13px 15px;
  resize: vertical;
}

select {
  min-height: 47px;
  padding: 0 12px;
  margin-bottom: 13px;
}

.url-row input::placeholder,
textarea::placeholder {
  color: #726979;
}

.url-row input:hover,
textarea:hover,
select:hover {
  border-color: rgba(255, 255, 255, 0.20);
}

.url-row input:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: #ff647c;
  background: rgba(9, 8, 17, 0.92);
  box-shadow: 0 0 0 4px rgba(255, 64, 93, 0.11);
}

.hint {
  margin: 11px 0 0;
  color: #9f92a3;
  font-size: 12px;
  line-height: 1.75;
}

/* Buttons */

.button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 46px;
  padding: 11px 17px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.045);
  color: #f9edf3;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
  cursor: pointer;
  transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease, background 200ms ease;
}

.button:active {
  transform: scale(0.975);
}

.button.primary {
  overflow: hidden;
  border-color: rgba(255, 154, 145, 0.60);
  background: linear-gradient(110deg, #e52b4e, #ff405d 48%, #e9a451);
  background-size: 180% 100%;
  color: #fffaf7;
  box-shadow: 0 7px 23px rgba(255, 64, 93, 0.18), inset 0 1px rgba(255, 255, 255, 0.28);
  transition: background-position 350ms ease, transform 200ms ease, box-shadow 200ms ease;
}

.button.primary:hover {
  background-position: 100% 0;
  box-shadow: 0 10px 30px rgba(255, 64, 93, 0.30), inset 0 1px rgba(255, 255, 255, 0.35);
  transform: translateY(-1px);
}

.button.primary span {
  font-size: 17px;
  line-height: 1;
}

.button.quiet {
  min-height: 37px;
  padding: 8px 12px;
  color: #c5b4c6;
  font-size: 11px;
}

.button.quiet:hover {
  border-color: rgba(242, 188, 105, 0.35);
  background: rgba(242, 188, 105, 0.07);
  color: #ffdbab;
}

.button.full {
  width: 100%;
  margin-top: 3px;
}

/* Video details */

.details {
  margin-top: 23px;
  padding-top: 21px;
  border-top: 1px solid rgba(255, 255, 255, 0.09);
  animation: rise-in 350ms both;
}

.video-meta {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.thumb {
  width: 112px;
  aspect-ratio: 16 / 9;
  flex-shrink: 0;
  object-fit: cover;
  border: 1px solid rgba(242, 188, 105, 0.25);
  border-radius: 10px;
  background: #0b0b12;
  transition: border-color 200ms ease;
}

.video-meta h3 {
  margin: 0;
  overflow-wrap: anywhere;
  color: #fff6f5;
  font-size: 15px;
  line-height: 1.5;
}

.video-meta .hint {
  margin-top: 5px;
}

/* Download activity */

.jobs-section {
  margin-top: 35px;
  animation: rise-in 450ms both;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 15px;
}

.section-heading .eyebrow {
  margin: 0 0 7px;
  padding: 4px 9px;
  font-size: 9px;
}

.section-heading h2 {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.7px;
}

.jobs-list {
  display: grid;
  gap: 11px;
}

.job,
.job-card {
  padding: 17px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 15px;
  background: linear-gradient(130deg, rgba(34, 24, 37, 0.92), rgba(16, 17, 28, 0.95));
  transition: border-color 220ms ease, transform 220ms ease;
}

.job:hover,
.job-card:hover {
  border-color: rgba(255, 112, 133, 0.28);
  transform: translateY(-2px);
}

.status,
.job-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 9px;
  border: 1px solid rgba(242, 188, 105, 0.20);
  border-radius: 999px;
  background: rgba(242, 188, 105, 0.07);
  color: #f2c77f;
  font-size: 10px;
  font-weight: 750;
}

.status.completed,
.job-status.completed,
.status.success {
  border-color: rgba(242, 188, 105, 0.32);
  background: rgba(242, 188, 105, 0.10);
  color: #f4ca83;
}

.status.failed,
.job-status.failed,
.status.error {
  border-color: rgba(255, 64, 93, 0.30);
  background: rgba(255, 64, 93, 0.10);
  color: #ff8797;
}

.progress,
.progress-bar {
  height: 6px;
  overflow: hidden;
  margin-top: 13px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
}

.progress span,
.progress-bar span,
.progress-fill {
  display: block;
  height: 100%;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #c62845, #ff405d, #f0a45c, #ffdc91);
  box-shadow: 0 0 15px rgba(255, 64, 93, 0.25);
  transition: width 350ms ease;
}

/* Privacy note */

.safety-note {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-top: 27px;
  padding: 17px 18px;
  border: 1px solid rgba(242, 188, 105, 0.15);
  border-radius: 15px;
  background: linear-gradient(115deg, rgba(255, 64, 93, 0.045), rgba(242, 188, 105, 0.035));
}

.shield {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border: 1px solid rgba(242, 188, 105, 0.23);
  border-radius: 10px;
  background: rgba(242, 188, 105, 0.08);
  color: #f3c77f;
  font-size: 15px;
}

.safety-note strong {
  color: #f2c58a;
  font-size: 12px;
}

.safety-note p {
  margin: 4px 0 0;
  color: #a99cab;
  font-size: 11px;
  line-height: 1.75;
}

/* Footer */

footer {
  padding: 0 20px 25px;
  color: #746979;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 2px;
  text-align: center;
}

footer span {
  padding: 0 5px;
  color: var(--gold);
}

/* Toast notifications */

.toast {
  position: fixed;
  z-index: 100;
  right: 22px;
  bottom: 22px;
  max-width: min(390px, calc(100% - 44px));
  padding: 13px 17px;
  border: 1px solid rgba(255, 112, 133, 0.35);
  border-radius: 13px;
  background: rgba(30, 20, 34, 0.97);
  color: #fff5f6;
  box-shadow: 0 20px 65px rgba(0, 0, 0, 0.5);
  font-size: 13px;
  animation: rise-in 250ms both;
}

/* Animations */

@keyframes atmosphere {
  0% {
    transform: translate3d(-2%, -1%, 0) scale(1);
  }
  50% {
    transform: translate3d(2%, 2%, 0) scale(1.07);
  }
  100% {
    transform: translate3d(-1%, 3%, 0) scale(1.02);
  }
}

@keyframes gradient-flow {
  to {
    background-position: 200% center;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    box-shadow: 0 0 12px rgba(242, 188, 105, 0.65);
  }
  50% {
    opacity: 0.55;
    box-shadow: 0 0 4px rgba(242, 188, 105, 0.25);
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Accessibility: respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Mobile */

@media (max-width: 600px) {
  .topbar {
    width: calc(100% - 28px);
    min-height: 68px;
  }

  .brand {
    font-size: 19px;
  }

  .brand-mark {
    width: 35px;
    height: 35px;
  }

  .local-tag {
    padding: 6px 9px;
    font-size: 10px;
  }

  .shell {
    width: calc(100% - 28px);
    padding-top: 45px;
  }

  .hero {
    margin-bottom: 26px;
  }

  .hero h1 {
    font-size: clamp(34px, 9vw, 48px);
    letter-spacing: -2px;
  }

  .subtitle {
    font-size: 13px;
  }

  .panel {
    padding: 6px;
    border-radius: 18px;
  }

  .tabs {
    gap: 4px;
    padding: 5px;
  }

  .tab {
    padding: 9px 5px;
    font-size: 11px;
  }

  .tab span {
    margin-right: 4px;
  }

  .pane {
    padding: 21px 12px 17px;
  }

  .url-row {
    flex-direction: column;
  }

  .url-row .button {
    width: 100%;
  }

  .video-meta {
    align-items: flex-start;
    gap: 11px;
  }

  .thumb {
    width: 94px;
  }

  .video-meta h3 {
    font-size: 13px;
  }

  .section-heading h2 {
    font-size: 19px;
  }

  .safety-note {
    padding: 14px;
  }

  .toast {
    right: 14px;
    bottom: 14px;
    max-width: calc(100% - 28px);
  }
}


/* ===== Klipora motion refresh: additive overrides, downloader logic unchanged ===== */
:root {
  --klipora-red: #ff3158;
  --klipora-pink: #ff7c91;
  --klipora-blue: #8db7ff;
  --klipora-panel: rgba(12, 16, 29, .82);
}

html { scroll-behavior: smooth; }
body {
  isolation: isolate;
  background:
    radial-gradient(ellipse at 15% 8%, rgba(255, 35, 83, .17), transparent 34rem),
    radial-gradient(ellipse at 88% 22%, rgba(73, 89, 255, .12), transparent 32rem),
    radial-gradient(ellipse at 50% 100%, rgba(255, 83, 123, .07), transparent 36rem),
    #070911;
  background-attachment: fixed;
}
body::before {
  content: "";
  position: fixed;
  inset: -25%;
  z-index: -1;
  pointer-events: none;
  background: conic-gradient(from 120deg at 50% 50%,
    transparent 0deg, rgba(255,49,88,.07) 70deg,
    transparent 145deg, rgba(92,124,255,.06) 230deg, transparent 310deg);
  filter: blur(72px);
  animation: klipora-ambient 24s linear infinite;
}
.topbar {
  position: relative;
  border-bottom: 1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
}
.brand { gap: 13px; }
.brand-mark {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255,49,88,.19), rgba(91,87,255,.10));
  border: 1px solid rgba(255,49,88,.58);
  box-shadow: 0 0 28px rgba(255,49,88,.14), inset 0 0 16px rgba(255,255,255,.035);
  animation: klipora-logo-glow 4s ease-in-out infinite;
}
.brand-mark::after {
  content: "";
  position: absolute;
  inset: -60%;
  background: linear-gradient(110deg, transparent 40%, rgba(255,255,255,.25) 50%, transparent 60%);
  transform: translateX(-70%) rotate(15deg);
  animation: klipora-shine 6s ease-in-out infinite;
}
.top-nav { display:flex; align-items:center; gap:clamp(12px, 2.5vw, 30px); }
.top-nav > a {
  color: var(--muted, #a8adbc);
  text-decoration:none;
  font-size:.9rem;
  font-weight:650;
  transition: color .2s ease, transform .2s ease;
}
.top-nav > a:hover { color:#fff; transform:translateY(-2px); }
.hero { position:relative; padding-top:clamp(52px, 8vw, 104px); }
.hero .eyebrow {
  border:1px solid rgba(255,49,88,.32);
  background:rgba(255,49,88,.07);
  box-shadow:0 0 34px rgba(255,49,88,.07);
  animation: klipora-rise .7s both;
}
.hero h1 {
  letter-spacing:-.065em;
  text-wrap:balance;
  animation: klipora-rise .8s .08s both;
}
.hero h1 span {
  background:linear-gradient(95deg, #8fb7ff 0%, #d5dfff 33%, #ffb4c3 68%, #ff4166 100%);
  background-size:220% auto;
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  animation: klipora-gradient 9s ease-in-out infinite;
}
.hero .subtitle { animation: klipora-rise .8s .16s both; }
.hero-pills {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
  margin:24px auto 0;
  animation: klipora-rise .8s .24s both;
}
.hero-pills > span {
  display:inline-flex;
  align-items:center;
  gap:8px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:999px;
  padding:9px 13px;
  color:#c3c7d4;
  background:rgba(255,255,255,.035);
  font-size:.78rem;
  font-weight:650;
  transition:transform .25s ease, border-color .25s ease, background .25s ease;
}
.hero-pills > span:hover {
  transform:translateY(-3px);
  border-color:rgba(255,49,88,.38);
  background:rgba(255,49,88,.07);
}
.status-dot { width:7px; height:7px; border-radius:50%; background:#12c99a; box-shadow:0 0 12px rgba(18,201,154,.7); }
.panel {
  position:relative;
  overflow:hidden;
  background:linear-gradient(145deg, rgba(15,20,36,.94), rgba(13,11,23,.88));
  border:1px solid rgba(156,169,206,.19);
  box-shadow:0 24px 80px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.035);
  backdrop-filter:blur(18px);
  animation: klipora-rise .8s .25s both;
}
.panel::before {
  content:"";
  position:absolute;
  top:0; left:-120%;
  width:70%; height:1px;
  background:linear-gradient(90deg, transparent, rgba(255,105,137,.9), transparent);
  animation: klipora-panel-sweep 8s ease-in-out infinite;
  pointer-events:none;
}
.tab { transition:color .2s ease, background .25s ease, transform .25s ease, box-shadow .25s ease; }
.tab:hover { transform:translateY(-1px); }
input:focus, textarea:focus, select:focus {
  outline:none;
  border-color:rgba(255,73,112,.82) !important;
  box-shadow:0 0 0 4px rgba(255,49,88,.11), 0 0 28px rgba(255,49,88,.09) !important;
}
.button.primary {
  position:relative;
  overflow:hidden;
  background:linear-gradient(105deg, #ff3158, #e9184d 58%, #ff526d);
  box-shadow:0 10px 26px rgba(255,30,78,.18), inset 0 1px rgba(255,255,255,.18);
  transition:transform .22s ease, box-shadow .22s ease, filter .22s ease;
}
.button.primary::after {
  content:"";
  position:absolute;
  inset:0;
  transform:translateX(-130%);
  background:linear-gradient(110deg, transparent 25%, rgba(255,255,255,.24) 50%, transparent 75%);
  transition:transform .7s ease;
  pointer-events:none;
}
.button.primary:hover {
  transform:translateY(-2px);
  filter:saturate(1.1);
  box-shadow:0 14px 34px rgba(255,30,78,.28), inset 0 1px rgba(255,255,255,.2);
}
.button.primary:hover::after { transform:translateX(130%); }
.button.primary:active { transform:translateY(0) scale(.985); }
.details, .jobs-section, .safety-note { animation:klipora-rise .45s ease both; }
.safety-note {
  border:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.025);
  backdrop-filter:blur(12px);
}
.site-footer {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  padding:34px 20px 38px;
  color:#9ca3b5;
  text-align:center;
}
.footer-brand { display:flex; align-items:center; gap:10px; color:#f5f6fa; font-size:1.15rem; }
.footer-brand .brand-mark { width:34px; height:34px; font-size:.95rem; }
.site-footer p { max-width:540px; margin:0; line-height:1.7; font-size:.88rem; }
.footer-caption { margin-top:8px; font-size:.7rem; letter-spacing:.16em; font-weight:800; opacity:.65; }
.footer-caption span { color:var(--klipora-red); }
@keyframes klipora-ambient { to { transform:rotate(360deg); } }
@keyframes klipora-logo-glow {
  0%,100% { box-shadow:0 0 22px rgba(255,49,88,.12), inset 0 0 16px rgba(255,255,255,.035); }
  50% { box-shadow:0 0 32px rgba(255,49,88,.25), 0 0 48px rgba(91,87,255,.08), inset 0 0 16px rgba(255,255,255,.05); }
}
@keyframes klipora-shine {
  0%,72%,100% { transform:translateX(-70%) rotate(15deg); }
  86% { transform:translateX(70%) rotate(15deg); }
}
@keyframes klipora-rise {
  from { opacity:0; transform:translateY(18px); }
  to { opacity:1; transform:translateY(0); }
}
@keyframes klipora-gradient { 0%,100% { background-position:0% center; } 50% { background-position:100% center; } }
@keyframes klipora-panel-sweep {
  0%,55% { left:-120%; }
  85%,100% { left:150%; }
}
@media (max-width:640px) {
  .top-nav { gap:10px; }
  .top-nav > a { display:none; }
  .hero { padding-top:46px; }
  .hero-pills { gap:7px; }
  .hero-pills > span { padding:8px 10px; font-size:.72rem; }
  .site-footer { padding-bottom:28px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration:.01ms !important;
    animation-iteration-count:1 !important;
    scroll-behavior:auto !important;
    transition-duration:.01ms !important;
  }
}
